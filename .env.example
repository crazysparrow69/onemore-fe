# All variables are required. Vite refuses to start if any is missing or invalid.

# Dev server and preview port (integer 1-65535). Not exposed to the browser.
PORT=5002

# Dev-server proxy target for /api. Not exposed to the browser.
API_URL=http://localhost:5001

# Neon Auth base URL from the Neon Console. Public, exposed to the browser.
VITE_NEON_AUTH_URL=https://example.neonauth.eu-central-1.aws.neon.tech/neondb/auth
